extends layout/main-layout.pug

block styles
  link(rel="stylesheet", href="/css/product.css")

block content
  main
    if prods.length > 0
      .grid
        each product in prods
          article.card.product-item
            header.card__header
              h1.product__title #{product.title}
            div.card__image
              img(
                src="https://tse3.mm.bing.net/th/id/OIP.LGkXPfo2WSpCnRrg4Z1VZQHaIW?cb=ucfimg2&ucfimg=1&rs=1&pid=ImgDetMain&o=7&rm=3",
                alt="Book"
              )
            div.card__content
              h2.product__price $19.99
              p.product__description A very interesting book about so many even more interesting subjects!
            .card__actions
              button.btn Add to Cart
    else 
      h1 No Products



